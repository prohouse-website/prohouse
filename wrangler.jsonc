{
  "name": "prohouse",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "0 23 * * *",
      "0 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "UTILITY_SCAN_LIMIT",
      "namespace_id": "7013345",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "SHAREBILL_USAGE_LIMIT",
      "namespace_id": "7013355",
      "simple": {
        "limit": 45,
        "period": 60
      }
    },
    {
      "name": "LONGSTAY_FORM_LIMIT",
      "namespace_id": "7013375",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "vars": {
    "SURVEY_FROM_EMAIL": "ProHouse Survey <no-reply@prohouse.com.au>",
    "APPLICATION_FROM_EMAIL": "ProHouse Long Stay <no-reply@prohouse.com.au>",
    "PROHOUSE_ADMIN_EMAILS": "hi@prohouse.com.au",
    "CLEANER_FROM_EMAIL": "ProHouse Agreements <no-reply@prohouse.com.au>",
    "VENDOR_PORTAL_ORIGIN": "https://new-vendor-agreement-portal-prohouse.hi-07f.workers.dev",
    "ANALYTICS_FROM_EMAIL": "ProHouse Share Bill <no-reply@prohouse.com.au>",
    "DIDIT_WORKFLOW_ID": "f7f47ff2-b92d-4676-9280-132b116adbde",
    "DIDIT_LONGSTAY_MONTHLY_LIMIT": "50"
  },
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "ratelimits": [
      {
        "name": "UTILITY_SCAN_LIMIT",
        "namespace_id": "7013346",
        "simple": {
          "limit": 8,
          "period": 60
        }
      },
      {
        "name": "SHAREBILL_USAGE_LIMIT",
        "namespace_id": "7013356",
        "simple": {
          "limit": 45,
          "period": 60
        }
      },
      {
        "name": "LONGSTAY_FORM_LIMIT",
        "namespace_id": "7013376",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ],
    "vars": {
      "SURVEY_FROM_EMAIL": "ProHouse Survey Preview <no-reply@prohouse.com.au>",
      "APPLICATION_FROM_EMAIL": "ProHouse Long Stay Preview <no-reply@prohouse.com.au>",
      "PROHOUSE_ADMIN_EMAILS": "hi@prohouse.com.au",
      "CLEANER_FROM_EMAIL": "ProHouse Agreements Preview <no-reply@prohouse.com.au>",
      "DIDIT_WORKFLOW_ID": "f7f47ff2-b92d-4676-9280-132b116adbde",
      "DIDIT_MONTHLY_LIMIT": "25",
      "VENDOR_PORTAL_ORIGIN": "https://new-vendor-agreement-portal-prohouse.hi-07f.workers.dev",
      "ANALYTICS_FROM_EMAIL": "ProHouse Share Bill Preview <no-reply@prohouse.com.au>",
      "DIDIT_LONGSTAY_MONTHLY_LIMIT": "25"
    },
    "d1_databases": [
      {
        "binding": "LONGSTAY_DB",
        "database_name": "prohouse-longstay-applications-preview",
        "database_id": "fab94e28-8373-414e-9c11-20f51aeb73cf",
        "preview_database_id": "fab94e28-8373-414e-9c11-20f51aeb73cf"
      },
      {
        "binding": "SHAREBILL_ANALYTICS_DB",
        "database_name": "prohouse-sharebill-analytics-preview",
        "database_id": "edb3beb3-cb60-4d50-9aaf-a523fc4b27ff",
        "preview_database_id": "edb3beb3-cb60-4d50-9aaf-a523fc4b27ff"
      },
      {
        "binding": "CLEANER_DB",
        "database_name": "prohouse-cleaner-agreements-preview",
        "database_id": "9e99d3d9-221a-46a7-b958-09261129655c",
        "migrations_dir": "migrations",
        "preview_database_id": "9e99d3d9-221a-46a7-b958-09261129655c"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "LONGSTAY_DB",
      "database_name": "prohouse-longstay-applications",
      "database_id": "186905a3-ff12-4fb2-883b-ba9e0c8b2c12",
      "preview_database_id": "fab94e28-8373-414e-9c11-20f51aeb73cf"
    },
    {
      "binding": "SHAREBILL_ANALYTICS_DB",
      "database_name": "prohouse-sharebill-analytics",
      "database_id": "c0f3bfb1-098b-442b-ab7d-4688d8859b16",
      "preview_database_id": "edb3beb3-cb60-4d50-9aaf-a523fc4b27ff"
    },
    {
      "binding": "CLEANER_DB",
      "database_name": "prohouse-cleaner-agreements",
      "database_id": "713bac7f-7f86-4e1d-b056-3fe60fac8ae9",
      "migrations_dir": "migrations",
      "preview_database_id": "9e99d3d9-221a-46a7-b958-09261129655c"
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
