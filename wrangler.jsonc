{
  "name": "prohouse",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "vars": {
    "SURVEY_FROM_EMAIL": "ProHouse Survey <no-reply@prohouse.com.au>",
    "PROHOUSE_ADMIN_EMAILS": "hi@prohouse.com.au",
    "CLEANER_FROM_EMAIL": "ProHouse Agreements <no-reply@prohouse.com.au>",
    "VENDOR_PORTAL_ORIGIN": "https://new-vendor-agreement-portal-prohouse.hi-07f.workers.dev"
  },
  "previews": {
    "vars": {
      "SURVEY_FROM_EMAIL": "ProHouse Survey Preview <no-reply@prohouse.com.au>",
      "PROHOUSE_ADMIN_EMAILS": "hi@prohouse.com.au",
      "CLEANER_FROM_EMAIL": "ProHouse Agreements Preview <no-reply@prohouse.com.au>",
      "DIDIT_WORKFLOW_ID": "f7f47ff2-b92d-4676-9280-132b116adbde",
      "DIDIT_MONTHLY_LIMIT": "25",
      "VENDOR_PORTAL_ORIGIN": "https://new-vendor-agreement-portal-prohouse.hi-07f.workers.dev"
    },
    "d1_databases": [
      {
        "binding": "CLEANER_DB",
        "database_name": "prohouse-cleaner-agreements-preview",
        "database_id": "9e99d3d9-221a-46a7-b958-09261129655c",
        "migrations_dir": "migrations",
        "preview_database_id": "9e99d3d9-221a-46a7-b958-09261129655c"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "CLEANER_DB",
      "database_name": "prohouse-cleaner-agreements",
      "database_id": "713bac7f-7f86-4e1d-b056-3fe60fac8ae9",
      "migrations_dir": "migrations",
      "preview_database_id": "9e99d3d9-221a-46a7-b958-09261129655c"
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
